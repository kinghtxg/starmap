# 强制关键文件使用 LF，避免 Windows 检出后 CI（Linux）上出现
#   bash: scripts/xxx.sh: /bin/bash^M: bad interpreter
#   Makefile: missing separator
# 这类"只在 CI 上炸"的问题。
* text=auto

# .gitattributes 自身必须是 LF，否则规则行尾带 \r 会被整体忽略
.gitattributes text eol=lf

*.sh        text eol=lf
*.py        text eol=lf
Makefile    text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.go        text eol=lf
*.md        text eol=lf

# 二进制/媒体不做行尾转换
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.exe       binary
*.pcap      binary
